<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Nairobi Nganya Bus Service</title>
<style>
:root{--bg:#fff8ec;--surface:#ffffff;--text:#1b1330;--muted:#5d5470;--pri:#e6194b;--acc:#f5a800;--grn:#0a9d58;--line:#e8dcc6;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#120a24;--surface:#1d1238;--text:#f6f0ff;--muted:#b4a8d0;--pri:#ff3d71;--acc:#ffc933;--grn:#2ee59d;--line:#3a2a63;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#120a24;--surface:#1d1238;--text:#f6f0ff;--muted:#b4a8d0;--pri:#ff3d71;--acc:#ffc933;--grn:#2ee59d;--line:#3a2a63;color-scheme:dark}
html{scroll-behavior:smooth;scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:"Trebuchet MS",system-ui,sans-serif;line-height:1.5}
h1,h2,h3{font-family:Impact,"Arial Black",sans-serif;letter-spacing:.5px;margin:0}
nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;display:flex;gap:14px;align-items:center;justify-content:space-between;flex-wrap:wrap;padding:10px 5vw;background:var(--surface);border-bottom:3px solid var(--acc)}
nav b{font-family:Impact,sans-serif;font-size:20px;color:var(--pri)}
nav div a{margin-left:14px;color:var(--text);text-decoration:none;font-weight:700;font-size:14px}
nav button{border:2px solid var(--acc);background:none;color:var(--text);border-radius:20px;padding:4px 12px;cursor:pointer;font-weight:700}
.hero{padding:48px 5vw 20px;text-align:center;background:linear-gradient(135deg,var(--pri),#7b2cbf 60%,#2d1b69);color:#fff;overflow:hidden}
.hero h1{font-size:clamp(34px,7vw,68px);text-shadow:3px 3px 0 #0006}
.hero p{max-width:560px;margin:10px auto 18px}
.btn{display:inline-block;background:var(--acc);color:#1b1330;border:0;border-radius:30px;padding:12px 26px;font-weight:800;font-size:16px;cursor:pointer;text-decoration:none}
.btn:hover{transform:scale(1.05)}
.road{position:relative;height:130px;margin-top:20px;border-bottom:6px dashed #fff8}
.bus{position:absolute;bottom:6px;left:-220px;width:200px;animation:drive 9s linear infinite}
.bus:hover{animation-play-state:paused}
@keyframes drive{to{left:105%}}
.wheel{transform-origin:center;transform-box:fill-box;animation:spin .5s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
section{padding:44px 5vw;max-width:1050px;margin:auto}
h2{font-size:clamp(26px,4vw,38px);color:var(--pri);margin-bottom:14px}
.card{background:var(--surface);border:2px solid var(--line);border-radius:16px;padding:18px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px}
label{display:block;font-weight:700;font-size:13px;margin:10px 0 4px}
select,input{width:100%;padding:10px;border-radius:10px;border:2px solid var(--line);background:var(--bg);color:var(--text);font-size:15px}
.fare{font-family:Impact,sans-serif;font-size:42px;color:var(--grn)}
.rt{cursor:pointer;transition:.2s}
.rt:hover,.rt.on{border-color:var(--pri);transform:translateY(-4px)}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
.chip{background:var(--bg);border:2px solid var(--line);border-radius:20px;padding:5px 12px;font-size:13px;font-weight:700;cursor:pointer;color:var(--text)}
.chip.on{background:var(--pri);color:#fff;border-color:var(--pri)}
.board div{display:flex;justify-content:space-between;padding:9px 4px;border-bottom:1px dashed var(--line);font-family:"Courier New",monospace;font-weight:700}
.tag{color:var(--grn)}
.ticket{margin-top:14px;border:3px dashed var(--acc);border-radius:14px;padding:14px;background:var(--bg)}
.ticket[hidden]{display:none}
.fx{display:flex;gap:10px;flex-wrap:wrap}
.fx .card{flex:1 1 150px;text-align:center;cursor:pointer;font-weight:800}
.neon .bodycol{fill:#7b2cbf}
details{background:var(--surface);border:2px solid var(--line);border-radius:12px;padding:10px 14px;margin-bottom:8px}
summary{cursor:pointer;font-weight:800}
footer{text-align:center;padding:26px;background:#120a24;color:#cfc4ea}
.overlay{position:fixed;inset:0;pointer-events:none;background:radial-gradient(circle,#ff3d7133,#7b2cbf33,#2ee59d22);opacity:0;transition:.4s;z-index:4}
body.neon .overlay{opacity:1;animation:pulse 1.2s infinite alternate}
@keyframes pulse{to{filter:hue-rotate(120deg)}}

.strip{display:flex;gap:12px;width:max-content;animation:slide 45s linear infinite;margin-top:26px}
.strip:hover{animation-play-state:paused}
.strip img{height:150px;width:auto;border-radius:12px;border:3px solid #fff8;cursor:pointer}
@keyframes slide{to{transform:translateX(-50%)}}
.wrap{overflow:hidden;margin:0 -5vw}
.gal{columns:3 220px;column-gap:14px}
.ph{break-inside:avoid;margin-bottom:14px;position:relative;border-radius:14px;overflow:hidden;cursor:pointer;border:2px solid var(--line)}
.ph img{display:block;width:100%;height:auto;transition:transform .4s}
.ph:hover img{transform:scale(1.07)}
.ph span{position:absolute;left:0;right:0;bottom:0;padding:26px 10px 8px;background:linear-gradient(transparent,#000c);color:#fff;font-weight:800;font-size:14px}
.ph small{display:block;font-weight:400;opacity:.85}
.rt img{width:100%;height:130px;object-fit:cover;border-radius:10px;margin-bottom:8px}
.lb{position:fixed;inset:0;z-index:20;background:#000e;display:none;align-items:center;justify-content:center;flex-direction:column;padding:16px}
.lb.on{display:flex}
.lb img{max-width:92vw;max-height:78vh;border-radius:12px}
.lb p{color:#fff;font-weight:800;margin:10px 0 0;text-align:center}
.lb button{position:absolute;background:var(--acc);border:0;border-radius:50%;width:46px;height:46px;font-size:22px;cursor:pointer;font-weight:900}
</style>
</head>
<body>
<div class="overlay"></div>
<nav><b>NAIROBI NGANYA</b><div><a href="#routes">Routes</a><a href="#fleet">Fleet</a><a href="#board">Departures</a><a href="#book">Book</a><a href="#vibe">The Vibe</a><a href="#faq">FAQ</a><button id="th">Theme</button></div></nav>

<header class="hero">
<h1>Nairobi Nganya Bus Service</h1>
<p>Graffiti on the outside, bass on the inside. Ride the city’s most colourful nganyas from town to your estate, safe, fast and loud.</p>
<a class="btn" href="#book">Book a seat</a>
<div class="wrap"><div class="strip" id="strip"></div></div>
<div class="road">
<svg class="bus" viewBox="0 0 200 90" aria-label="Animated nganya bus">
<rect class="bodycol" x="5" y="15" width="185" height="50" rx="12" fill="#e6194b"/>
<rect x="5" y="45" width="185" height="8" fill="#f5a800"/>
<rect x="18" y="22" width="26" height="20" rx="4" fill="#bfe9ff"/><rect x="50" y="22" width="26" height="20" rx="4" fill="#bfe9ff"/><rect x="82" y="22" width="26" height="20" rx="4" fill="#bfe9ff"/><rect x="114" y="22" width="26" height="20" rx="4" fill="#bfe9ff"/>
<path d="M146 20h34a8 8 0 0 1 8 8v14h-42z" fill="#bfe9ff"/>
<text x="20" y="60" font-size="9" font-weight="900" fill="#fff" font-family="Impact">NGANYA KINGS</text>
<circle cx="185" cy="56" r="4" fill="#fff36b"/>
<g><circle cx="42" cy="68" r="12" fill="#111"/><circle class="wheel" cx="42" cy="68" r="6" fill="#ddd"/><circle cx="150" cy="68" r="12" fill="#111"/><circle class="wheel" cx="150" cy="68" r="6" fill="#ddd"/></g>
</svg>
</div>
</header>

<section id="routes">
<h2>Pick your route</h2>
<div class="grid" id="rgrid"></div>
<div class="card" style="margin-top:16px">
<h3>Fare calculator</h3>
<div class="grid">
<div><label for="from">From</label><select id="from"><option>Nairobi CBD</option></select>
<label for="to">To</label><select id="to"></select></div>
<div><label for="pax">Passengers</label><input id="pax" type="number" min="1" max="14" value="1">
<label for="ty">Ticket type</label><select id="ty"><option value="1">Standard</option><option value="1.3">Premium seat (+30%)</option><option value="0.7">Student (-30%)</option></select></div>
<div><label>Total fare</label><div class="fare" id="total">KSh 0</div><small style="color:var(--muted)">Sample fares for demo. Update with your real prices.</small></div>
</div></div>
</section>

<section id="fleet">
<h2>Meet the fleet</h2>
<p>Tap any nganya to see it big.</p>
<div class="gal" id="gal"></div>
</section>

<section id="board">
<h2>Next departures</h2>
<div class="chips" id="bchips"></div>
<div class="card board" id="bd" style="margin-top:12px"></div>
</section>

<section id="book">
<h2>Book a seat</h2>
<div class="card">
<div class="grid">
<div><label for="nm">Your name</label><input id="nm" placeholder="e.g. Wanjiku"></div>
<div><label for="ph">Phone (M-Pesa)</label><input id="ph" placeholder="07XX XXX XXX" inputmode="tel"></div>
<div><label for="bt">Departure time</label><select id="bt"></select></div>
</div>
<p style="margin:12px 0 0"><button class="btn" id="bk">Confirm booking</button></p>
<div class="ticket" id="tk" hidden></div>
</div>
</section>

<section id="vibe">
<h2>The nganya vibe</h2>
<p>Tap a feature to switch it on for the ride.</p>
<div class="fx" id="fx"></div>
</section>

<section id="faq">
<h2>Questions</h2>
<details><summary>How do I pay?</summary><p>M-Pesa or cash on board. Pay when you book or when you board.</p></details>
<details><summary>Where do buses leave from?</summary><p>All routes depart from our Nairobi CBD stage. Arrive 10 minutes early.</p></details>
<details><summary>Can I carry luggage?</summary><p>Yes, small bags ride free. Bigger items may cost extra.</p></details>
<details><summary>Do you run at night?</summary><p>Yes, late services run on busy routes, with the lights show on.</p></details>
</section>

<footer>© 2026 Nairobi Nganya Bus Service · Nairobi, Kenya<br>Call/WhatsApp: add your number here</footer>
<div class="lb" id="lb"><button id="lx" style="top:14px;right:14px">✕</button><button id="lp" style="left:10px">‹</button><button id="ln" style="right:10px">›</button><img id="li" alt=""><p id="lt"></p></div>

<script>
var $=function(i){return document.getElementById(i)};
var P=[{"n": "Bomaye", "s": "Silver king of the road", "u": "data:image/jpeg;base64,"}, {"n": "Bomaye Night", "s": "Rain, lights and bass", "u": "data:image/jpeg;base64,"}, {"n": "Detroit Lions", "s": "Blue and white machine", "u": "data:image/jpeg;base64,"}, {"n": "Mood", "s": "Purple graffiti vibes", "u": "data:image/jpeg;base64,"}, {"n": "Money Fest", "s": "Yellow cash-flow cruiser", "u": "data:image/jpeg;base64,"}, {"n": "John Wick", "s": "Chrome and neon strips", "u": "data:image/jpeg;base64,"}, {"n": "Heisenberg", "s": "Teal camo art", "u": "data:image/jpeg;base64,"}, {"n": "Moxie", "s": "Pink pattern queen", "u": "data:image/jpeg;base64,"}, {"n": "F.B.I", "s": "Red camo express", "u": "data:image/jpeg;base64,"}, {"n": "Bee", "s": "Honeycomb yellow", "u": "data:image/jpeg;base64,"}, {"n": "Red Skull", "s": "Glowing red night rider", "u": "data:image/jpeg;base64,"}];
var li=0;
function show(i){li=(i+P.length)%P.length;$("li").src=P[li].u;$("lt").textContent=P[li].n+" · "+P[li].s;$("lb").classList.add("on");}
(function(){var g=$("gal"),s=$("strip");
P.forEach(function(p,i){g.insertAdjacentHTML("beforeend",'<div class="ph" data-g="'+i+'"><img loading="lazy" src="'+p.u+'" alt="'+p.n+'"><span>'+p.n+'<small>'+p.s+'</small></span></div>');});
P.concat(P).forEach(function(p,i){s.insertAdjacentHTML("beforeend",'<img data-g="'+(i%P.length)+'" src="'+p.u+'" alt="'+p.n+'">');});
document.addEventListener("click",function(e){var c=e.target.closest("[data-g]");if(c)show(+c.dataset.g);});
$("lx").onclick=function(){$("lb").classList.remove("on")};
$("lp").onclick=function(){show(li-1)};$("ln").onclick=function(){show(li+1)};
$("lb").onclick=function(e){if(e.target.id=="lb")$("lb").classList.remove("on")};
document.addEventListener("keydown",function(e){if(!$("lb").classList.contains("on"))return;if(e.key=="Escape")$("lb").classList.remove("on");if(e.key=="ArrowLeft")show(li-1);if(e.key=="ArrowRight")show(li+1);});
})();

var R=[
{n:"Rongai",f:80,e:"🏙️",t:"35 min"},{n:"Ngong",f:100,e:"⛰️",t:"45 min"},
{n:"Umoja",f:60,e:"🏘️",t:"30 min"},{n:"Githurai",f:70,e:"🛍️",t:"40 min"},
{n:"Kitengela",f:120,e:"🌾",t:"55 min"},{n:"Kasarani",f:60,e:"🏟️",t:"35 min"}];
var cur=0;
function fillRoutes(){
var g=$("rgrid"),to=$("to"),ch=$("bchips");g.innerHTML="";to.innerHTML="";ch.innerHTML="";
R.forEach(function(r,i){
g.insertAdjacentHTML("beforeend",'<div class="card rt'+(i==cur?" on":"")+'" data-i="'+i+'"><img src="'+P[(i*2)%P.length].u+'" alt=""><h3>CBD → '+r.n+'</h3><p>KSh '+r.f+' · about '+r.t+'</p></div>');
to.insertAdjacentHTML("beforeend",'<option value="'+i+'">'+r.n+'</option>');
ch.insertAdjacentHTML("beforeend",'<button class="chip'+(i==cur?" on":"")+'" data-i="'+i+'">'+r.n+'</button>');});
to.value=cur;calc();board();}
function calc(){var r=R[$("to").value];$("total").textContent="KSh "+Math.round(r.f*Math.max(1,+$("pax").value||1)*$("ty").value);}
function times(){var d=new Date(),m=d.getHours()*60+d.getMinutes(),o=[],s=Math.ceil((m+5)/20)*20;
for(var i=0;i<6;i++){var x=(s+i*20)%1440,h=Math.floor(x/60),mm=x%60;o.push((h<10?"0":"")+h+":"+(mm<10?"0":"")+mm);}return o;}
function board(){var t=times(),r=R[cur],b=$("bd");b.innerHTML="";
t.forEach(function(x,i){b.insertAdjacentHTML("beforeend","<div><span>"+x+"  CBD → "+r.n+"</span><span class='tag'>"+(i==0?"BOARDING":"ON TIME")+"</span></div>");});
$("bt").innerHTML=t.map(function(x){return "<option>"+x+"</option>"}).join("");}
function pick(i){cur=+i;fillRoutes();}
document.addEventListener("click",function(e){var c=e.target.closest("[data-i]");if(c)pick(c.dataset.i);});
$("to").onchange=function(){pick(this.value)};$("pax").oninput=calc;$("ty").onchange=calc;
$("bk").onclick=function(){var n=$("nm").value.trim(),p=$("ph").value.trim();
if(!n||p.length<9){alert("Please add your name and phone number.");return;}
var id="NG"+Math.floor(1000+Math.random()*9000),r=R[cur],k=$("tk");
k.hidden=false;k.innerHTML="<b>🎟️ Ticket "+id+"</b><br>"+n+" · CBD → "+r.n+"<br>Departs "+$("bt").value+" · "+$("pax").value+" seat(s)<br><b>"+$("total").textContent+"</b> · pay via M-Pesa or on board";
try{localStorage.setItem("lastTicket",k.innerHTML)}catch(e){}};
var F=[["🔊","Sound system"],["💡","LED light show"],["📶","Free Wi-Fi"],["🎨","Graffiti art"]];
F.forEach(function(f){var d=document.createElement("div");d.className="card";d.textContent=f[0]+" "+f[1];
d.onclick=function(){d.style.borderColor=d.style.borderColor?"":"var(--pri)";
if(f[1]=="LED light show")document.body.classList.toggle("neon");
d.textContent=f[0]+" "+f[1]+(d.style.borderColor?" ✓ ON":"");};$("fx").appendChild(d);});
$("th").onclick=function(){var r=document.documentElement,d=getComputedStyle(r).colorScheme=="dark";r.setAttribute("data-theme",d?"light":"dark");};
fillRoutes();
</script>
</body>
</html>
